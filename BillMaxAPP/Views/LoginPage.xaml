<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:BillMaxAPP.ViewModels"
    x:Class="BillMaxAPP.Views.LoginPage"
    x:DataType="viewmodels:LoginViewModel"
    NavigationPage.HasNavigationBar="False"
    BackgroundColor="#EEF2FF">

    <Grid RowDefinitions="3.2*,4.8*">

        <!-- ================= TOP GRADIENT ================= -->

        <Grid Grid.Row="0">

            <Grid.Background>
                <LinearGradientBrush
                    StartPoint="0,0"
                    EndPoint="1,1">

                    <GradientStop Offset="0.0"
                                  Color="#C7D2FE"/>

                    <GradientStop Offset="0.45"
                                  Color="#DDD6FE"/>

                    <GradientStop Offset="1"
                                  Color="#F5F3FF"/>

                </LinearGradientBrush>
            </Grid.Background>

        </Grid>


        <!-- ================= BOTTOM CARD ================= -->

        <Border
            Grid.Row="1"
            Margin="0,-45,0,0"
            BackgroundColor="White"
            StrokeThickness="0"
            Padding="26,28,26,20">

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="30,30,0,0"/>
            </Border.StrokeShape>

            <ScrollView>

                <VerticalStackLayout
                    Spacing="22">
                    <!-- Heading -->

                    <VerticalStackLayout
                        Spacing="6">

                        <Label
                            Text="Welcome back !!"
                            FontSize="34"
                            FontAttributes="Bold"
                            TextColor="#1F2937"/>

                        <Label
                            Text="Sign in to continue to your dashboard"
                            FontSize="15"
                            TextColor="#6B7280"/>

                    </VerticalStackLayout>

                    <!-- ================= EMAIL ================= -->

                    <VerticalStackLayout Spacing="8">

                        <Label
        Text="Email or Mobile Number"
        FontSize="14"
        FontAttributes="Bold"
        TextColor="#374151"/>

                        <Border
        HeightRequest="56"
        BackgroundColor="#FFFFFF"
        Stroke="#E5E7EB"
        StrokeThickness="1">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>

                            <Grid
            ColumnDefinitions="50,*"
            Padding="14,0">

                                <Image
                Grid.Column="0"
                Source="user.png"
                WidthRequest="18"
                HeightRequest="18"
                VerticalOptions="Center"
                HorizontalOptions="Center"/>

                                <Entry
                Grid.Column="1"
                Placeholder="Enter email or mobile number"
                PlaceholderColor="#9CA3AF"
                Text="{Binding Username}"
                Keyboard="Email"
                FontSize="15"
                TextColor="#111827"
                BackgroundColor="Transparent"
                ClearButtonVisibility="WhileEditing"
                VerticalOptions="Center"/>

                            </Grid>

                        </Border>

                    </VerticalStackLayout>


                    <!-- ================= PASSWORD ================= -->

                    <VerticalStackLayout Spacing="8">

                        <Grid ColumnDefinitions="*,Auto">

                            <Label
            Grid.Column="0"
            Text="Password"
            FontSize="14"
            FontAttributes="Bold"
            TextColor="#374151"/>

                            <Label
            Grid.Column="1"
            Text="Forgot password?"
            FontSize="13"
            FontAttributes="Bold"
            TextColor="#4F46E5">

                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer
                    Tapped="OnForgotPasswordTapped"/>
                                </Label.GestureRecognizers>

                            </Label>

                        </Grid>


                        <Border
        HeightRequest="56"
        BackgroundColor="#FFFFFF"
        Stroke="#E5E7EB"
        StrokeThickness="1">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>

                            <Grid
            ColumnDefinitions="50,*,40"
            Padding="14,0">

                                <Image
                Grid.Column="0"
                Source="lock.png"
                WidthRequest="18"
                HeightRequest="18"
                VerticalOptions="Center"
                HorizontalOptions="Center"/>

                                <Entry
                x:Name="PasswordEntry"
                Grid.Column="1"
                Placeholder="Enter password"
                PlaceholderColor="#9CA3AF"
                Text="{Binding Password}"
                FontSize="15"
                IsPassword="True"
                TextColor="#111827"
                BackgroundColor="Transparent"
                VerticalOptions="Center"/>

                                <ImageButton
                x:Name="TogglePasswordButton"
                Grid.Column="2"
                Source="ic_eye.png"
                WidthRequest="22"
                HeightRequest="22"
                BackgroundColor="Transparent"
                Clicked="OnTogglePasswordClicked"
                VerticalOptions="Center"
                HorizontalOptions="Center"/>

                            </Grid>

                        </Border>

                    </VerticalStackLayout>


                    <!-- ================= REMEMBER ================= -->

                    <Grid
    Margin="0,2,0,0"
    ColumnDefinitions="Auto,*">

                        <CheckBox
        Grid.Column="0"
        IsChecked="{Binding RememberMe}"
        Color="#4F46E5"
        VerticalOptions="Center"/>

                        <Label
        Grid.Column="1"
        Margin="8,0,0,0"
        Text="Remember me for 30 days"
        FontSize="14"
        TextColor="#4B5563"
        VerticalOptions="Center"/>

                    </Grid>


                    <!-- ================= LOGIN ================= -->

                    <Grid Margin="0,10,0,0">

                        <Button
        HeightRequest="56"
        CornerRadius="12"
        BackgroundColor="#4F46E5"
        Text="Sign in"
        FontSize="16"
        FontAttributes="Bold"
        TextColor="White"
        Command="{Binding LoginCommand}"
        IsEnabled="{Binding IsNotBusy}"/>

                        <ActivityIndicator
        IsRunning="{Binding IsBusy}"
        IsVisible="{Binding IsBusy}"
        Color="White"
        HorizontalOptions="Center"
        VerticalOptions="Center"/>

                    </Grid>


                    <!-- ================= FOOTER ================= -->

                    <Label
    Margin="0,18,0,0"
    HorizontalOptions="Center"
    FontSize="13">

                        <Label.FormattedText>

                            <FormattedString>

                                <Span
                Text="Need help? "
                TextColor="#6B7280"/>

                                <Span
                Text="Contact support@billmax.store"
                TextColor="#4F46E5"
                FontAttributes="Bold"/>

                            </FormattedString>

                        </Label.FormattedText>

                    </Label>

                </VerticalStackLayout>

            </ScrollView>

        </Border>

    </Grid>

</ContentPage>