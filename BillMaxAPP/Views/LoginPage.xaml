<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BillMaxAPP.Views.LoginPage"
             Title="LoginPage">
    <ScrollView>
        <VerticalStackLayout
        Padding="30"
        Spacing="20"
        VerticalOptions="Center">

            <!-- Logo -->
            <Label
            Text="BILLMAX"
            FontSize="32"
            FontAttributes="Bold"
            TextColor="#1E88E5"
            HorizontalOptions="Center"/>

            <Label
            Text="Welcome Back"
            FontSize="24"
            FontAttributes="Bold"
            HorizontalOptions="Center"/>

            <Label
            Text="Sign in to continue"
            FontSize="14"
            TextColor="Gray"
            HorizontalOptions="Center"/>

            <Entry
    Placeholder="Email or Mobile Number"
    Text="{Binding Username, Mode=TwoWay}"
    Keyboard="Email"
    HeightRequest="50"
    BackgroundColor="#F5F5F5"
    Margin="0,20,0,0"/>

            <Entry
    Text="{Binding Password, Mode=TwoWay}"
    Placeholder="Password"
    IsPassword="True"
    HeightRequest="50"
    BackgroundColor="#F5F5F5"/>

            <Button
    Text="Sign In"
    Command="{Binding LoginCommand}"
    HeightRequest="50"
    CornerRadius="10"
    BackgroundColor="#1E88E5"
    TextColor="White"
    FontAttributes="Bold"
    Margin="0,20,0,0"/>

            <Label
            Text="Version 1.0.0"
            HorizontalOptions="Center"
            TextColor="Gray"
            Margin="0,30,0,0"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>


