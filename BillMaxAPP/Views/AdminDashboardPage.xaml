<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="BillMaxAPP.Views.AdminDashboardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:components="clr-namespace:BillMaxAPP.Views.Components"
    Title="Dashboard"
    BackgroundColor="#F5F7FA">

    <ScrollView>

        <VerticalStackLayout
            Padding="15"
            Spacing="20">


            <Grid
        Padding="4,8"
        ColumnDefinitions="*,Auto"
        VerticalOptions="Center">

                <!-- Left Side -->
                <VerticalStackLayout Spacing="2">

                    <Label
                Text="Admin Dashboard"
                FontSize="20"
                FontAttributes="Bold"   
                TextColor="#1F2937" />

                    <Label
                Text="Overview of all stores and platform activity"
                FontSize="12"
                TextColor="#6B7280" />

                </VerticalStackLayout>

                <!-- Right Side -->
                <Button
            Grid.Column="1"
HeightRequest="35"
BackgroundColor="#2563EB"
CornerRadius="8"
FontSize="12"
Text="+ New Store"
TextColor="White"
            VerticalOptions="Center" />

            </Grid>



            <!-- Summary Cards -->

            <Grid
    ColumnDefinitions="*,*"
    RowDefinitions="Auto,Auto"
    ColumnSpacing="15"
    RowSpacing="15">


                <components:DashboardCard
Grid.Row="0"
Grid.Column="0"
Title="Total Stores"
Value="{Binding Dashboard.TotalStores}"
Subtitle="{Binding Dashboard.NewStoresThisMonth, StringFormat='{0} New'}"
Icon="store.png"
CardColor="#3B82F6"/>
                <components:DashboardCard
        Grid.Row="0"
        Grid.Column="1"
        Title="TOTAL BILLS"
        Value="{Binding Dashboard.TotalBills}"
        Subtitle="{Binding Dashboard.TodayInvoices, StringFormat='{0} Today'}"
        Icon="bill.png"
        CardColor="#F59E0B"/>

                <components:DashboardCard
        Grid.Row="1"
        Grid.Column="0"
        Title="Total Products"
        Value="{Binding Dashboard.TotalProducts}"
        Subtitle="{Binding Dashboard.TodayInvoices, StringFormat='{0} Today'}"
        Icon="product.png"
        CardColor="#10B981"/>

                

                <components:DashboardCard
        Grid.Row="1"
        Grid.Column="1"
        Title="Today's Sales"
        Value="{Binding Dashboard.TodaySales}"
        Subtitle="{Binding Dashboard.TodaySalesGrowth, StringFormat='{0}% Growth'}"
        Icon="sales.png"
        CardColor="#EF4444"/>

            </Grid>


            <!-- Sales Trend -->

            <components:SalesTrendCard
        TrendData="{Binding WeekTrend}"
        WeekCommand="{Binding WeekCommand}"
        MonthCommand="{Binding MonthCommand}"
        YearCommand="{Binding YearCommand}" />


            <!-- Top Stores -->

            <components:TopStoreCard
    TopStores="{Binding Dashboard.TopStores}" />


        </VerticalStackLayout>

    </ScrollView>

</ContentPage>