<?xml version="1.0" encoding="utf-8" ?>

<ContentView
    x:Class="BillMaxAPP.Views.Components.ProductCard"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="Root"
    xmlns:helpers="clr-namespace:BillMaxAPP.Helpers">

    <Border
    BackgroundColor="White"
    Stroke="#E5E7EB"
    StrokeThickness="1"
    Padding="8"
    HeightRequest="200">

    <Border.StrokeShape>
        <RoundRectangle CornerRadius="12" />
    </Border.StrokeShape>

    <Grid
        RowDefinitions="90,Auto,Auto"
        RowSpacing="6">

        <!-- ================= IMAGE ================= -->

        <Grid
            Grid.Row="0"
            HeightRequest="90">

            <Image
                Source="{Binding Product.ProductImage,
                Source={x:Reference Root},
                StringFormat='https://billmax.store/ProductImages/{0}'}"
                Aspect="AspectFit"
                HorizontalOptions="Center"
                VerticalOptions="Center" />

        </Grid>


        <!-- ================= PRODUCT NAME + QUANTITY ================= -->

        <Grid
            Grid.Row="1"
            ColumnDefinitions="*,Auto"
            ColumnSpacing="6">

            <!-- Product Name -->

            <Label
                Grid.Column="0"
                Text="{Binding Product.ProductName,
                               Source={x:Reference Root}}"
                FontSize="15"
                FontAttributes="Bold"
                TextColor="#374151"
                LineBreakMode="TailTruncation"
                MaxLines="1"
                VerticalOptions="Center" />


            <!-- Quantity -->

            <Label
                Grid.Column="1"
                Text="{Binding Product.Quantity,
                               Source={x:Reference Root}}"
                FontSize="14"
                TextColor="Orange"
                VerticalOptions="Center"
                HorizontalOptions="End" />

        </Grid>


        <!-- ================= PRICE + ADD ================= -->

        <Grid
            Grid.Row="2"
            ColumnDefinitions="*,Auto"
            ColumnSpacing="6">

            <!-- Price -->

            <Label
                Grid.Column="0"
                Text="{Binding Product.Price,
                               Source={x:Reference Root},
                               StringFormat='₹{0:F0}'}"
                FontSize="16"
                FontAttributes="Bold"
                TextColor="#111827"
                VerticalOptions="Center" />


            <!-- Add Button -->

            <Border
                Grid.Column="1"
                WidthRequest="80"
                HeightRequest="30"
                BackgroundColor="#F0EDFF"
                StrokeThickness="0"
                HorizontalOptions="End"
                VerticalOptions="Center">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="0" />
                </Border.StrokeShape>

                <Label
                    Text="Add "
                    FontSize="14"
                    TextColor="#4338CA"
                    FontAttributes="Bold"
                    HorizontalTextAlignment="Center"
                    VerticalTextAlignment="Center"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />

                <Border.GestureRecognizers>

                    <TapGestureRecognizer
                        Command="{Binding AddCommand,
                                          Source={x:Reference Root}}"
                        CommandParameter="{Binding Product,
                                                   Source={x:Reference Root}}" />

                </Border.GestureRecognizers>

            </Border>

        </Grid>

    </Grid>

</Border>

</ContentView>