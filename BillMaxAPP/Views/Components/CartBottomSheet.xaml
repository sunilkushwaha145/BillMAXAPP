<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="BillMaxAPP.Views.Components.CartBottomSheet"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:BillMaxAPP.Models">

    <!-- Root is an overlay: dim background + sliding card -->
    <Grid>

        <BoxView
        BackgroundColor="#80000000"
        Opacity="1">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CloseCommand, Source={x:Reference Root}}" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <Border
        VerticalOptions="End"
        BackgroundColor="White"
        StrokeThickness="0"
        MaximumHeightRequest="620"
        Padding="0">

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="20,20,0,0" />
            </Border.StrokeShape>

            <Grid RowDefinitions="Auto,*,Auto">

                <!-- Header -->
                <Grid Grid.Row="0" Padding="18,14,18,10" ColumnDefinitions="*,Auto">

                    <VerticalStackLayout Spacing="2">
                        <Label
                        Text="Your Cart"
                        FontSize="18"
                        FontAttributes="Bold"
                        TextColor="#111827" />

                        <Label
                        Text="{Binding CartItems.Count, Source={x:Reference Root}, StringFormat='{0} items'}"
                        FontSize="12"
                        TextColor="#6B7280" />
                    </VerticalStackLayout>

                    <ImageButton
                    Grid.Column="1"
                    Source="close.png"
                    BackgroundColor="#F3F4F6"
                    WidthRequest="34"
                    HeightRequest="34"
                    Padding="9"
                    Command="{Binding CloseCommand, Source={x:Reference Root}}" />

                </Grid>

                <!-- Cart lines -->
                <CollectionView
                Grid.Row="1"
                ItemsSource="{Binding CartItems, Source={x:Reference Root}}"
                SelectionMode="None"
                Margin="18,0"
                VerticalScrollBarVisibility="Never">

                    <CollectionView.ItemTemplate>

                        <DataTemplate x:DataType="models:CartItem">

                            <Border
                            BackgroundColor="#F8FAFC"
                            Stroke="#E5E7EB"
                            StrokeThickness="1"
                            Padding="10"
                            Margin="0,4">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>

                                <Grid ColumnDefinitions="48,*,Auto" ColumnSpacing="10">

                                    <Border
                                    Grid.Column="0"
                                    WidthRequest="48"
                                    HeightRequest="48"
                                    BackgroundColor="White"
                                    StrokeThickness="0">

                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="8" />
                                        </Border.StrokeShape>

                                        <Image
                                        Source="{Binding ProductImage, StringFormat='https://billmax.store/ProductImages/{0}'}"
                                        WidthRequest="44"
                                        HeightRequest="44"
                                        Aspect="AspectFit" />
                                    </Border>

                                    <VerticalStackLayout
                                    Grid.Column="1"
                                    Spacing="2"
                                    VerticalOptions="Center">

                                        <Label
                                        Text="{Binding ProductName}"
                                        FontSize="14"
                                        FontAttributes="Bold"
                                        TextColor="#111827"
                                        LineBreakMode="TailTruncation"
                                        MaxLines="1" />

                                        <Label
                                        Text="{Binding UnitPrice, StringFormat='₹{0:F2} each'}"
                                        FontSize="11"
                                        TextColor="#6B7280" />

                                        <Label
                                        Text="{Binding ItemTotal, StringFormat='₹{0:F2}'}"
                                        FontSize="13"
                                        FontAttributes="Bold"
                                        TextColor="#16A34A" />
                                    </VerticalStackLayout>

                                    <HorizontalStackLayout
                                    Grid.Column="2"
                                    Spacing="4"
                                    VerticalOptions="Center">

                                        <Button
                                        Text="−"
                                        WidthRequest="28"
                                        HeightRequest="28"
                                        Padding="0"
                                        CornerRadius="14"
                                        FontSize="16"
                                        BackgroundColor="#E5E7EB"
                                        TextColor="#111827"
                                        Command="{Binding Source={x:Reference Root}, Path=DecreaseCommand}"
                                        CommandParameter="{Binding .}" />

                                        <Label
                                        Text="{Binding Qty}"
                                        WidthRequest="24"
                                        FontSize="14"
                                        FontAttributes="Bold"
                                        HorizontalTextAlignment="Center"
                                        VerticalTextAlignment="Center"
                                        TextColor="#111827" />

                                        <Button
                                        Text="+"
                                        WidthRequest="28"
                                        HeightRequest="28"
                                        Padding="0"
                                        CornerRadius="14"
                                        FontSize="16"
                                        BackgroundColor="#16A34A"
                                        TextColor="White"
                                        Command="{Binding Source={x:Reference Root}, Path=IncreaseCommand}"
                                        CommandParameter="{Binding .}" />

                                    </HorizontalStackLayout>

                                </Grid>
                            </Border>

                        </DataTemplate>

                    </CollectionView.ItemTemplate>

                </CollectionView>

                <!-- Totals + Generate Bill -->
                <Border
                Grid.Row="2"
                BackgroundColor="#F8FAFC"
                StrokeThickness="0"
                Padding="18,12,18,18">

                    <VerticalStackLayout Spacing="9">

                        <!-- Customer details -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">

                            <Border
                            Grid.Column="0"
                            BackgroundColor="White"
                            Stroke="#E5E7EB"
                            StrokeThickness="1"
                            HeightRequest="42">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="9" />
                                </Border.StrokeShape>

                                <Entry
                                Text="{Binding CustomerName, Source={x:Reference Root}}"
                                Placeholder="Customer name"
                                PlaceholderColor="#9CA3AF"
                                FontSize="13"
                                TextColor="#111827"
                                BackgroundColor="Transparent"
                                Margin="4,0" />
                            </Border>

                            <Border
                            Grid.Column="1"
                            BackgroundColor="White"
                            Stroke="#E5E7EB"
                            StrokeThickness="1"
                            HeightRequest="42">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="9" />
                                </Border.StrokeShape>

                                <Entry
                                Text="{Binding CustomerMobile, Source={x:Reference Root}}"
                                Placeholder="Mobile number"
                                PlaceholderColor="#9CA3AF"
                                Keyboard="Telephone"
                                MaxLength="10"
                                FontSize="13"
                                TextColor="#111827"
                                BackgroundColor="Transparent"
                                Margin="4,0" />
                            </Border>

                        </Grid>

                        <!-- Payment type -->
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">

                            <Label
                            Text="Payment"
                            FontSize="12"
                            FontAttributes="Bold"
                            TextColor="#6B7280"
                            VerticalOptions="Center" />

                            <HorizontalStackLayout
                            Grid.Column="1"
                            Spacing="6">

                                <Button
                                Text="Cash"
                                HeightRequest="32"
                                Padding="12,0"
                                CornerRadius="16"
                                FontSize="12"
                                BackgroundColor="#DCFCE7"
                                TextColor="#15803D"
                                Command="{Binding SelectPaymentCommand, Source={x:Reference Root}}"
                                CommandParameter="Cash" />

                                <Button
                                Text="UPI"
                                HeightRequest="32"
                                Padding="12,0"
                                CornerRadius="16"
                                FontSize="12"
                                BackgroundColor="#EEF2FF"
                                TextColor="#4338CA"
                                Command="{Binding SelectPaymentCommand, Source={x:Reference Root}}"
                                CommandParameter="UPI" />

                                <Button
                                Text="Card"
                                HeightRequest="32"
                                Padding="12,0"
                                CornerRadius="16"
                                FontSize="12"
                                BackgroundColor="#F3F4F6"
                                TextColor="#374151"
                                Command="{Binding SelectPaymentCommand, Source={x:Reference Root}}"
                                CommandParameter="Card" />

                            </HorizontalStackLayout>
                        </Grid>

                        <BoxView
                        HeightRequest="1"
                        BackgroundColor="#E5E7EB"
                        Margin="0,2" />

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Subtotal" TextColor="#6B7280" FontSize="13" />
                            <Label
                            Grid.Column="1"
                            Text="{Binding SubTotal, Source={x:Reference Root}, StringFormat='₹{0:F2}'}"
                            FontSize="13" />
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="CGST" TextColor="#6B7280" FontSize="13" />
                            <Label
                            Grid.Column="1"
                            Text="{Binding CGST, Source={x:Reference Root}, StringFormat='₹{0:F2}'}"
                            FontSize="13" />
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="SGST" TextColor="#6B7280" FontSize="13" />
                            <Label
                            Grid.Column="1"
                            Text="{Binding SGST, Source={x:Reference Root}, StringFormat='₹{0:F2}'}"
                            FontSize="13" />
                        </Grid>

                        <Grid
                        ColumnDefinitions="*,Auto"
                        Margin="0,2,0,3">

                            <Label
                            Text="Grand Total"
                            FontAttributes="Bold"
                            FontSize="16"
                            TextColor="#111827" />

                            <Label
                            Grid.Column="1"
                            Text="{Binding GrandTotal, Source={x:Reference Root}, StringFormat='₹{0:F2}'}"
                            FontAttributes="Bold"
                            FontSize="18"
                            TextColor="#16A34A" />
                        </Grid>

                        <Button
                        Text="GENERATE BILL"
                        HeightRequest="48"
                        CornerRadius="12"
                        BackgroundColor="#16A34A"
                        TextColor="White"
                        FontSize="14"
                        FontAttributes="Bold"
                        Command="{Binding GenerateBillCommand, Source={x:Reference Root}}" />

                    </VerticalStackLayout>
                </Border>

            </Grid>
        </Border>

    </Grid>


</ContentView>
