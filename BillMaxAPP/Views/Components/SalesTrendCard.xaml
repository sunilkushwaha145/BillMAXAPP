<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="BillMaxAPP.Views.Components.SalesTrendCard"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Maui;assembly=LiveChartsCore.SkiaSharpView.Maui">

    <Border
        BackgroundColor="White"
        Padding="15"
        Stroke="#E5E7EB"
        StrokeThickness="1">

        <Border.StrokeShape>
            <RoundRectangle CornerRadius="15"/>
        </Border.StrokeShape>

        <VerticalStackLayout Spacing="15">

            <!-- Header -->

            <Grid ColumnDefinitions="*,Auto">

                <Label
                    Text="Sales Trend"
                    FontSize="18"
                    FontAttributes="Bold"
                    VerticalOptions="Center"/>
                <Grid
    Grid.Column="1"
    ColumnDefinitions="Auto,Auto,Auto"
    ColumnSpacing="0">

                    <!-- Week -->
                    <Border
        Grid.Column="0"
        WidthRequest="60"
        HeightRequest="35"
        BackgroundColor="#2563EB"
        StrokeThickness="0">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8,0,8,0"/>
                        </Border.StrokeShape>

                        <Label
            Text="Week"
            FontSize="12"
                            FontAttributes="Bold"
            TextColor="White"
            HorizontalOptions="Center"
            VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer
                    Command="{Binding Source={x:Reference Root}, Path=WeekCommand}" />
                            </Label.GestureRecognizers>
                        </Label>

                    </Border>

                    <!-- Month -->
                    <Border
        Grid.Column="1"
        WidthRequest="60"
        HeightRequest="35"
        BackgroundColor="#2563EB"
        StrokeThickness="0">

                        <Label
            Text="Month"
            FontSize="12"
            TextColor="White"
                            FontAttributes="Bold"
            HorizontalOptions="Center"
            VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer
                    Command="{Binding Source={x:Reference Root}, Path=MonthCommand}" />
                            </Label.GestureRecognizers>
                        </Label>

                    </Border>

                    <!-- Year -->
                    <Border
        Grid.Column="2"
        WidthRequest="60"
        HeightRequest="35"
        BackgroundColor="#2563EB"
        StrokeThickness="0">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="0,8,0,8"/>
                        </Border.StrokeShape>

                        <Label
            Text="Year"
            FontSize="12"
            TextColor="White"
                            FontAttributes="Bold"
            HorizontalOptions="Center"
            VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer
                    Command="{Binding Source={x:Reference Root}, Path=YearCommand}" />
                            </Label.GestureRecognizers>
                        </Label>

                    </Border>

                </Grid>

            </Grid>

            <!-- Chart Placeholder -->

            <Border
    HeightRequest="220"
    BackgroundColor="#F8FAFC"
    Stroke="#E5E7EB">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10"/>
                </Border.StrokeShape>

                <lvc:CartesianChart
        Series="{Binding Source={x:Reference Root}, Path=Series}"
        XAxes="{Binding Source={x:Reference Root}, Path=XAxes}" />
            </Border>

        </VerticalStackLayout>

    </Border>

</ContentView>