<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="BillMaxAPP.Views.Components.LowStockCard"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Border
        Padding="15"
        BackgroundColor="White"
        Stroke="#E5E7EB"
        StrokeThickness="1">

        <Border.StrokeShape>
            <RoundRectangle CornerRadius="15"/>
        </Border.StrokeShape>

        <VerticalStackLayout Spacing="10">

            <!-- Header -->
            <Grid ColumnDefinitions="Auto,*,Auto" VerticalOptions="Center">

                <Label
                    Grid.Column="0"
                    Text="&#9888;"
                    FontSize="18"
                    TextColor="#F59E0B"
                    Margin="0,0,8,0"
                    VerticalOptions="Center" />

                <Label
                    Grid.Column="1"
                    Text="Low Stock Alert"
                    FontAttributes="Bold"
                    FontSize="16"
                    TextColor="#111827"
                    VerticalOptions="Center" />

                <Border
                    Grid.Column="2"
                    Padding="9,3"
                    BackgroundColor="#EF4444"
                    VerticalOptions="Center">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10"/>
                    </Border.StrokeShape>

                    <Label
                        Text="{Binding Source={x:Reference Root}, Path=Count}"
                        FontAttributes="Bold"
                        FontSize="12"
                        TextColor="White" />

                </Border>

            </Grid>

            <BoxView HeightRequest="1" BackgroundColor="#F0F0F0" />

            <!-- Product List -->
            <CollectionView
                ItemsSource="{Binding Source={x:Reference Root}, Path=LowStockProducts}"
                SelectionMode="None">

                <CollectionView.ItemTemplate>

                    <DataTemplate>

                        <VerticalStackLayout>

                            <Grid Padding="0,12" ColumnDefinitions="*,Auto">

                                <VerticalStackLayout Grid.Column="0" Spacing="3" VerticalOptions="Center">

                                    <Label
                                        Text="{Binding ProductName}"
                                        FontSize="15"
                                        TextColor="#111827" />

                                    <Label
                                        Text="{Binding ProductCode, StringFormat='SKU: {0}'}"
                                        FontSize="12"
                                        TextColor="#9CA3AF" />

                                </VerticalStackLayout>

                                <Border
                                    Grid.Column="1"
                                    Padding="10,5"
                                    BackgroundColor="#FEF3C7"
                                    VerticalOptions="Center">

                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="8"/>
                                    </Border.StrokeShape>

                                    <Label
                                        Text="{Binding Quantity, StringFormat='{0} left'}"
                                        FontAttributes="Bold"
                                        FontSize="12"
                                        TextColor="#B45309" />

                                </Border>

                            </Grid>

                            <BoxView HeightRequest="1" BackgroundColor="#F0F0F0" />

                        </VerticalStackLayout>

                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>

        </VerticalStackLayout>

    </Border>

</ContentView>
