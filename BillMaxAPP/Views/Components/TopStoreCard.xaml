<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="BillMaxAPP.Views.Components.TopStoreCard"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:helpers="clr-namespace:BillMaxAPP.Helpers">


    <ContentView.Resources>
        <helpers:FirstLetterConverter x:Key="FirstLetterConverter" />
    </ContentView.Resources>
    
    <Border
        Padding="15"
        BackgroundColor="White"
        Stroke="#E5E7EB"
        StrokeThickness="1">

        <Border.StrokeShape>
            <RoundRectangle CornerRadius="15"/>
        </Border.StrokeShape>

        <VerticalStackLayout Spacing="15">

            <!-- Header -->
            <Grid ColumnDefinitions="*,Auto">

                <Label
                    FontAttributes="Bold"
                    FontSize="18"
                    Text="Top Stores"
                    VerticalOptions="Center" />

                <Button
                    Grid.Column="1"
                    WidthRequest="80"
                    HeightRequest="35"
                    BackgroundColor="#2563EB"
                    CornerRadius="8"
                    FontSize="12"
                    Text="Export"
                    TextColor="White" />

            </Grid>

            <!-- Store List -->

            <CollectionView
                ItemsSource="{Binding Source={x:Reference Root}, Path=TopStores}"
                SelectionMode="None">

                <CollectionView.ItemTemplate>

                    <DataTemplate>

                        <Border
                            Margin="0,5"
                            Padding="12"
                            BackgroundColor="#FAFAFA"
                            Stroke="#E5E7EB">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10"/>
                            </Border.StrokeShape>

                            <Grid ColumnDefinitions="50,*,Auto">

                                <!-- Avatar -->
                                <Border
                                    WidthRequest="42"
                                    HeightRequest="42"
                                    BackgroundColor="#3B82F6">

                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="21"/>
                                    </Border.StrokeShape>

                                    <Label
    HorizontalOptions="Center"
    VerticalOptions="Center"
    FontAttributes="Bold"
    FontSize="18"
    Text="{Binding UserName, Converter={StaticResource FirstLetterConverter}}"
    TextColor="White" />

                                </Border>

                                <!-- Details -->
                                <VerticalStackLayout
                                    Grid.Column="1"
                                    Margin="10,0"
                                    Spacing="2">

                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="15"
                                        Text="{Binding StoreName}" />

                                    <Label
                                        FontSize="12"
                                        Text="{Binding UserName}"
                                        TextColor="Gray" />

                                </VerticalStackLayout>

                                <!-- Amount -->
                                <Border
                                    Grid.Column="2"
                                    Padding="8,4"
                                    BackgroundColor="#DCFCE7">

                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="8"/>
                                    </Border.StrokeShape>

                                    <Label
                                        FontAttributes="Bold"
                                        Text="{Binding GrandTotal, StringFormat='₹{0:F2}'}"
                                        TextColor="#15803D" />

                                </Border>

                            </Grid>

                        </Border>

                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>

        </VerticalStackLayout>

    </Border>

</ContentView>