<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="BillMaxAPP.Views.Components.DashboardCard"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Border
        BackgroundColor="White"
        Padding="15"
        Stroke="#E5E7EB"
        StrokeThickness="1">

        <Border.StrokeShape>
            <RoundRectangle CornerRadius="15"/>
        </Border.StrokeShape>

        <Grid
            ColumnDefinitions="55,*"
            ColumnSpacing="12">

            <Border
                WidthRequest="50"
                HeightRequest="50"
                BackgroundColor="{Binding CardColor, Source={x:Reference Root}}"
                HorizontalOptions="Start"
                VerticalOptions="Start">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12"/>
                </Border.StrokeShape>

                <Image
                    Source="{Binding Icon, Source={x:Reference Root}}"
                    WidthRequest="24"
                    HeightRequest="24"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"/>

            </Border>

            <VerticalStackLayout
                Grid.Column="1"
                Spacing="3">

                <Label
                    Text="{Binding Title, Source={x:Reference Root}}"
                    FontSize="12"
                    FontAttributes="Bold"
                    TextColor="#6B7280"/>

                <Label
                    Text="{Binding Value, Source={x:Reference Root}}"
                    FontSize="16"
                    FontAttributes="Bold"
                    TextColor="#111827"/>

                <Label
                    Text="{Binding Subtitle, Source={x:Reference Root}}"
                    FontSize="12"
                    TextColor="#10B981"/>

            </VerticalStackLayout>

        </Grid>

    </Border>

</ContentView>