<?xml version="1.0" encoding="utf-8" ?>

<ContentView
    x:Class="BillMaxAPP.Views.Components.RecentBillsCard"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:helpers="clr-namespace:BillMaxAPP.Helpers">

    <ContentView.Resources>
        <helpers:BoolToStatusConverter x:Key="BoolToStatusConverter" />
    </ContentView.Resources>

    <Border
        BackgroundColor="White"
        Stroke="#E5E7EB"
        StrokeThickness="1"
        Padding="0">

        <Border.StrokeShape>
            <RoundRectangle CornerRadius="12" />
        </Border.StrokeShape>

        <VerticalStackLayout>

            <Grid Padding="16,12" ColumnDefinitions="*,Auto">
                <Label
                    Text="Recent Bills"
                    FontSize="16"
                    FontAttributes="Bold"
                    TextColor="#111827"
                    VerticalOptions="Center" />

                <Button
                    Grid.Column="1"
                    Text="View all"
                    BackgroundColor="Transparent"
                    TextColor="#2563EB"
                    FontSize="14"
                    Padding="5,0"
                    Command="{Binding ViewAllCommand, Source={x:Reference Root}}" />
            </Grid>

            <CollectionView
                ItemsSource="{Binding ItemsSource, Source={x:Reference Root}}"
                SelectionMode="None"
                Margin="12,0,12,12">

                <CollectionView.ItemTemplate>
                    <DataTemplate>

                        <Border
                            BackgroundColor="#FFFFFF"
                            Stroke="#E5E7EB"
                            StrokeThickness="1"
                            Padding="10,7"
                            Margin="0,2">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="9" />
                            </Border.StrokeShape>

                            <Grid RowDefinitions="Auto,Auto" RowSpacing="4">

                                <Grid
                                    Grid.Row="0"
                                    ColumnDefinitions="*,Auto">

                                    <Label
                                        Text="{Binding InvoiceNo}"
                                        FontSize="14"
                                        FontAttributes="Bold"
                                        TextColor="#1F2937"
                                        LineBreakMode="TailTruncation"
                                        VerticalOptions="Center" />

                                    <Border
                                        Grid.Column="1"
                                        BackgroundColor="#DCFCE7"
                                        Padding="9,3"
                                        VerticalOptions="Center"
                                        StrokeThickness="0">

                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="8" />
                                        </Border.StrokeShape>

                                        <Label
                                            Text="{Binding PayStatus, Converter={StaticResource BoolToStatusConverter}}"
                                            FontSize="10"
                                            FontAttributes="Bold"
                                            TextColor="#15803D" />
                                    </Border>
                                </Grid>

                                <Grid
                                    Grid.Row="1"
                                    ColumnDefinitions="*,Auto,Auto"
                                    ColumnSpacing="8">

                                    <Label
                                        Text="{Binding CustomerName}"
                                        FontSize="13"
                                        FontAttributes="Bold"
                                        TextColor="#374151"
                                        LineBreakMode="TailTruncation"
                                        MaxLines="1"
                                        VerticalOptions="Center" />

                                    <Label
                                        Grid.Column="1"
                                        Text="{Binding ItemsCount, StringFormat='{0} items'}"
                                        FontSize="11"
                                        TextColor="#6B7280"
                                        VerticalOptions="Center"
                                        HorizontalTextAlignment="End" />

                                    <HorizontalStackLayout
                                        Grid.Column="2"
                                        Spacing="6"
                                        VerticalOptions="Center">

                                        <Label
                                            Text="{Binding GrandTotal, StringFormat='₹ {0:F2}'}"
                                            FontSize="13"
                                            FontAttributes="Bold"
                                            TextColor="#111827"
                                            VerticalOptions="Center" />

                                        <Border
                                            WidthRequest="32"
                                            HeightRequest="32"
                                            BackgroundColor="#F8FAFC"
                                            Stroke="#E5E7EB"
                                            StrokeThickness="1">

                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="7" />
                                            </Border.StrokeShape>

                                            <ImageButton
                                                Source="details.png"
                                                BackgroundColor="Transparent"
                                                Padding="8"
                                                Command="{Binding BindingContext.ViewCommand, Source={x:Reference Root}}"
                                                CommandParameter="{Binding .}" />
                                        </Border>

                                        <Border
                                            WidthRequest="32"
                                            HeightRequest="32"
                                            BackgroundColor="#F8FAFC"
                                            Stroke="#E5E7EB"
                                            StrokeThickness="1">

                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="7" />
                                            </Border.StrokeShape>

                                            <ImageButton
                                                Source="print.png"
                                                BackgroundColor="Transparent"
                                                Padding="8"
                                                Command="{Binding BindingContext.PrintCommand, Source={x:Reference Root}}"
                                                CommandParameter="{Binding .}" />
                                        </Border>
                                    </HorizontalStackLayout>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </Border>
</ContentView>
