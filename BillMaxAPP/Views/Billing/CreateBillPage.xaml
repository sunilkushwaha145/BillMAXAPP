<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:BillMaxAPP.ViewModels"
    xmlns:components="clr-namespace:BillMaxAPP.Views.Components"
    xmlns:models="clr-namespace:BillMaxAPP.Models"
    x:Class="BillMaxAPP.Views.CreateBillPage"
    x:Name="ThisPage"
    x:DataType="vm:CreateBillViewModel"
    Title="Create Bill"
    BackgroundColor="White">

    <Grid>

        <Grid ColumnDefinitions="70,*">

            <!-- LEFT: Category sidebar -->
            <components:CategorySidebar
                Grid.Column="0"
                Categories="{Binding Categories}"
                SelectCommand="{Binding SelectCategoryCommand}" />

            <!-- RIGHT: Products -->
            <Grid Grid.Column="1" RowDefinitions="*">

                <RefreshView
                    Command="{Binding SelectCategoryCommand}"
                    CommandParameter="{Binding SelectedCategory}"
                    IsRefreshing="{Binding IsBusy}">

                    <CollectionView
                        ItemsSource="{Binding Products}"
                        SelectionMode="None"
                        Margin="8">

                        <CollectionView.ItemsLayout>
                            <GridItemsLayout Orientation="Vertical" Span="2" VerticalItemSpacing="8" HorizontalItemSpacing="8" />
                        </CollectionView.ItemsLayout>

                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Product">
                                <components:ProductCard
                                    Product="{Binding .}"
                                    AddCommand="{Binding Source={x:Reference ThisPage}, Path=BindingContext.AddToCartCommand}" />
                            </DataTemplate>
                        </CollectionView.ItemTemplate>

                        <CollectionView.EmptyView>
                            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Padding="30">
                                <Label
                                    Text="{Binding EmptyStateMessage}"
                                    HorizontalTextAlignment="Center"
                                    TextColor="#6B7280" />
                            </VerticalStackLayout>
                        </CollectionView.EmptyView>

                    </CollectionView>

                </RefreshView>

            </Grid>

        </Grid>

        <!-- Bottom cart bar (only visible when cart has items) -->
        <components:CartBar
            Margin="12"
            VerticalOptions="End"
            IsVisible="{Binding IsCartVisible}"
            ItemCount="{Binding CartCount}"
            CartTotal="{Binding GrandTotal}"
            TapCommand="{Binding OpenCartCommand}" />

        <!-- Slide-up cart sheet overlay -->
        <components:CartBottomSheet
            IsVisible="{Binding IsCartSheetVisible}"
            CartItems="{Binding CartItems}"
            SubTotal="{Binding SubTotal}"
            CGST="{Binding CGST}"
            SGST="{Binding SGST}"
            GrandTotal="{Binding GrandTotal}"
            IncreaseCommand="{Binding IncreaseQtyCommand}"
            DecreaseCommand="{Binding DecreaseQtyCommand}"
            GenerateBillCommand="{Binding GenerateBillCommand}"
            CloseCommand="{Binding CloseCartCommand}" 
            CustomerName="{Binding CustomerName}"
    CustomerMobile="{Binding CustomerMobile}"
    PaymentType="{Binding PaymentType}"
            SelectPaymentCommand="{Binding SelectPaymentCommand}"
            />

        <ActivityIndicator
            IsRunning="{Binding IsBusy}"
            IsVisible="{Binding IsBusy}"
            Color="#16A34A"
            HorizontalOptions="Center"
            VerticalOptions="Center" />

    </Grid>

</ContentPage>
