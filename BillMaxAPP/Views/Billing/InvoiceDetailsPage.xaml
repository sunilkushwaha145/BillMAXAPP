<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="BillMaxAPP.Views.InvoiceDetailsPage"
    Title="Invoice Details"
    BackgroundColor="#F8FAFC">

    <Grid RowDefinitions="Auto,*,Auto">

        <Grid
            Grid.Row="0"
            Padding="16,12"
            ColumnDefinitions="Auto,*,Auto"
            BackgroundColor="White">

            <ImageButton
                Source="back.png"
                WidthRequest="32"
                HeightRequest="32"
                BackgroundColor="Transparent"
                Clicked="BackButton_Clicked" />

            <Label
                Grid.Column="1"
                Text="Invoice Details"
                FontSize="18"
                FontAttributes="Bold"
                TextColor="#111827"
                HorizontalOptions="Center"
                VerticalOptions="Center" />

        </Grid>

        <ScrollView Grid.Row="1">

            <VerticalStackLayout
                Padding="16,12,16,20"
                Spacing="12">

                <Border
                    BackgroundColor="White"
                    Stroke="#E5E7EB"
                    StrokeThickness="1"
                    Padding="16">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>

                    <Grid
                        RowDefinitions="Auto,Auto"
                        ColumnDefinitions="*,Auto">

                        <VerticalStackLayout Spacing="4">

                            <Label
                                Text="{Binding InvoiceId, StringFormat='INV-{0:D6}'}"
                                FontSize="20"
                                FontAttributes="Bold"
                                TextColor="#111827" />

                            <Label
                                Text="{Binding Crd, StringFormat='{0:dd MMM yyyy, hh:mm tt}'}"
                                FontSize="12"
                                TextColor="#64748B" />

                        </VerticalStackLayout>

                        <Border
                            Grid.Column="1"
                            Padding="10,5"
                            BackgroundColor="#DCFCE7"
                            StrokeThickness="0"
                            VerticalOptions="Start">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>

                            <Label
                                Text="PAID"
                                FontSize="11"
                                FontAttributes="Bold"
                                TextColor="#15803D" />

                        </Border>

                        <Label
                            Grid.Row="1"
                            Text="{Binding PayType}"
                            FontSize="13"
                            TextColor="#475569"
                            Margin="0,12,0,0" />

                    </Grid>

                </Border>

                <Border
                    BackgroundColor="White"
                    Stroke="#E5E7EB"
                    StrokeThickness="1"
                    Padding="16">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="6">

                        <Label
                            Text="CUSTOMER"
                            FontSize="11"
                            FontAttributes="Bold"
                            TextColor="#64748B" />

                        <Label
                            Text="{Binding Customers.Name}"
                            FontSize="16"
                            FontAttributes="Bold"
                            TextColor="#111827" />

                        <Label
                            Text="{Binding Customers.Mobile}"
                            FontSize="13"
                            TextColor="#475569" />

                    </VerticalStackLayout>

                </Border>

                <Border
                    BackgroundColor="White"
                    Stroke="#E5E7EB"
                    StrokeThickness="1"
                    Padding="16">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="10">

                        <Label
                            Text="ITEMS"
                            FontSize="11"
                            FontAttributes="Bold"
                            TextColor="#64748B" />

                        <Grid ColumnDefinitions="*,50,90">

                            <Label
                                Text="Product"
                                FontSize="11"
                                TextColor="#64748B" />

                            <Label
                                Grid.Column="1"
                                Text="Qty"
                                FontSize="11"
                                TextColor="#64748B"
                                HorizontalTextAlignment="Center" />

                            <Label
                                Grid.Column="2"
                                Text="Amount"
                                FontSize="11"
                                TextColor="#64748B"
                                HorizontalTextAlignment="End" />

                        </Grid>

                        <CollectionView
                            ItemsSource="{Binding CartItem}"
                            SelectionMode="None">

                            <CollectionView.ItemTemplate>

                                <DataTemplate>

                                    <Grid
                                        ColumnDefinitions="*,50,90"
                                        Padding="0,7">

                                        <Label
                                            Text="{Binding ProductName}"
                                            FontSize="13"
                                            TextColor="#111827"
                                            LineBreakMode="TailTruncation" />

                                        <Label
                                            Grid.Column="1"
                                            Text="{Binding Qty}"
                                            FontSize="13"
                                            TextColor="#475569"
                                            HorizontalTextAlignment="Center" />

                                        <Label
                                            Grid.Column="2"
                                            Text="{Binding PriceWithGST, StringFormat='₹{0:F2}'}"
                                            FontSize="13"
                                            TextColor="#111827"
                                            HorizontalTextAlignment="End" />

                                    </Grid>

                                </DataTemplate>

                            </CollectionView.ItemTemplate>

                        </CollectionView>

                    </VerticalStackLayout>

                </Border>

                <Border
                    BackgroundColor="#F8FAFC"
                    StrokeThickness="0"
                    Padding="16">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="7">

                        <Grid ColumnDefinitions="*,Auto">

                            <Label
                                Text="Subtotal"
                                FontSize="13"
                                TextColor="#64748B" />

                            <Label
                                Grid.Column="1"
                                Text="{Binding SubTotal, StringFormat='₹{0:F2}'}"
                                FontSize="13"
                                TextColor="#111827" />

                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">

                            <Label
                                Text="CGST"
                                FontSize="13"
                                TextColor="#64748B" />

                            <Label
                                Grid.Column="1"
                                Text="{Binding CGST, StringFormat='₹{0:F2}'}"
                                FontSize="13"
                                TextColor="#111827" />

                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">

                            <Label
                                Text="SGST"
                                FontSize="13"
                                TextColor="#64748B" />

                            <Label
                                Grid.Column="1"
                                Text="{Binding SGST, StringFormat='₹{0:F2}'}"
                                FontSize="13"
                                TextColor="#111827" />

                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">

                            <Label
                                Text="Discount"
                                FontSize="13"
                                TextColor="#64748B" />

                            <Label
                                Grid.Column="1"
                                Text="{Binding Discount, StringFormat='₹{0:F2}'}"
                                FontSize="13"
                                TextColor="#111827" />

                        </Grid>

                        <BoxView
                            HeightRequest="1"
                            BackgroundColor="#E5E7EB"
                            Margin="0,4" />

                        <Grid ColumnDefinitions="*,Auto">

                            <Label
                                Text="Grand Total"
                                FontSize="17"
                                FontAttributes="Bold"
                                TextColor="#111827" />

                            <Label
                                Grid.Column="1"
                                Text="{Binding GrandTotal, StringFormat='₹{0:F2}'}"
                                FontSize="18"
                                FontAttributes="Bold"
                                TextColor="#16A34A" />

                        </Grid>

                    </VerticalStackLayout>

                </Border>

            </VerticalStackLayout>

        </ScrollView>

        <!--<Grid
            Grid.Row="2"
            Padding="16,10,16,16"
            BackgroundColor="White">

            <Button
                Text="BACK"
                HeightRequest="48"
                CornerRadius="12"
                BackgroundColor="#16A34A"
                TextColor="White"
                FontAttributes="Bold"
                Clicked="BackButton_Clicked" />

        </Grid>-->

    </Grid>

</ContentPage>