<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="BillMaxAPP.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:BillMaxAPP.Views"
    FlyoutBehavior="Flyout">

    <FlyoutItem
        Title="Dashboard"
        Icon="home.png"
        Route="dashboard">
        <ShellContent
            ContentTemplate="{DataTemplate views:AdminDashboardPage}" />
    </FlyoutItem>

    <FlyoutItem
        Title="Stores"
        Icon="store.png"
        Route="stores">
        <ShellContent
            ContentTemplate="{DataTemplate views:StoreMgntPage}" />
    </FlyoutItem>

    <FlyoutItem
        Title="Report"
        Icon="report.png"
        Route="report">
        <ShellContent
            ContentTemplate="{DataTemplate views:ReportPage}" />
    </FlyoutItem>

    <FlyoutItem
        Title="GST Setting"
        Icon="gst.png"
        Route="gst">
        <ShellContent
            ContentTemplate="{DataTemplate views:GSTSettingPage}" />
    </FlyoutItem>

    <FlyoutItem
        Title="Profile"
        Icon="profile.png"
        Route="profile">
        <ShellContent
            ContentTemplate="{DataTemplate views:ProfilePage}" />
    </FlyoutItem>

    <!-- ===================== FLYOUT FOOTER (Logout Button) ===================== -->
    <Shell.FlyoutFooter>
        <Grid Padding="20,15" BackgroundColor="White">
            <Button
                Text="Logout"
                Clicked="OnLogoutClicked"
                BackgroundColor="#EF4444"
                TextColor="White"
                CornerRadius="10"
                HeightRequest="45"
                FontAttributes="Bold" />
        </Grid>
    </Shell.FlyoutFooter>
</Shell>